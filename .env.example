# Firebase web app config — Firebase Console → Project Settings → General →
# Your apps → SDK setup and configuration → Config.
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. These are client-side config values (not secrets
# in the traditional sense — Firestore/Auth access is still governed by
# security rules), but they stay in environment variables rather than
# source so nothing is hardcoded and per-environment values (dev/staging/
# prod projects) never require a code change.
#
# Firestore project region: asia-southeast3 (Bangkok) — set at database
# creation time in the Firebase Console, not configured here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Which Repository Provider backend to resolve (src/config/backend.ts).
# 'mock' (or unset) — everything reads/writes the in-memory Mock Repository,
#   same as today. Safe default; the Firebase vars above aren't even read.
# 'firestore' — Product Master, Customers, and Service Jobs use their real
#   Firestore repositories (requires the Firebase vars above to be filled in).
#   This is an opt-in code path only; it does not change any deployed frontend
#   configuration by itself.
VITE_BACKEND_KIND=mock

# Which backend the attachments repository uses (src/config/filesBackend.ts)
# — deliberately independent of VITE_BACKEND_KIND above. Business data
# (Firestore) and file bytes (Cloudflare Worker + R2, see worker/) are two
# separate systems per the approved F5 architecture; this lets either be
# Mock or real without the other having to match.
# 'mock' (or unset) — attachments live in an in-memory Mock repository, same
#   as every other repository defaults to. Safe default.
# 'worker' — attachments upload/download/delete through the Worker at
#   VITE_FILES_WORKER_URL below. Requires VITE_BACKEND_KIND=firestore so the
#   attachment's parent Service Job and retention anchor are durable, and the
#   Worker to actually be running (see worker/README.md).
VITE_FILES_BACKEND=mock

# Base URL of the Cloudflare Worker from worker/. Required whenever
# VITE_FILES_BACKEND=worker; there is no silent fallback. Development may
# explicitly use the local `wrangler dev` origin below. A production build
# accepts only the approved HTTPS production Worker origin documented in
# PROJECT_STATE.md's F5d-61 section.
VITE_FILES_WORKER_URL=http://127.0.0.1:8787

# The unauthenticated but bearer-token-protected public tracking route. This
# has its own setting so public browser calls never reuse staff file transport.
# It has no silent fallback. The staff-only initial production rollout must
# leave it unset; public tracking then renders its explicit unavailable state.
# Local development may uncomment the value below when testing a local
# Worker whose public routes have also been deliberately enabled.
# VITE_PUBLIC_TRACKING_WORKER_URL=http://127.0.0.1:8787
