{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:service-jobs": "node --test test/serviceJobRetentionAnchor.test.mjs",
    "test:service-job-brand": "node --test test/serviceJobBrand.test.mjs",
    "test:service-reports": "node --test test/serviceReportRepository.test.mjs",
    "test:service-reports-ui": "node --test test/serviceReportUi.test.mjs",
    "test:service-reports-print": "node --test test/serviceReportPrint.test.mjs",
    "test:attachment-retention": "node --test test/attachmentRetentionLifecycle.test.mjs",
    "test:ownership-public-tracking": "node --test test/ownershipPublicTracking.test.mjs",
    "test:public-tracking-browser": "node --test test/publicTrackingBrowser.test.mjs",
    "test:auth-readiness": "node --test --test-concurrency=1 test/authSession.test.mjs test/workerTokenProvider.test.mjs test/firestoreReadiness.test.mjs",
    "test:backend-configuration": "node --test test/backendConfiguration.test.mjs",
    "test:firestore-rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore \"node --test test/firestoreRules.test.mjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.26.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
