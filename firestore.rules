rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staffProfilePath() {
      return /databases/$(database)/documents/staffProfiles/$(request.auth.uid);
    }

    function canonicalBrand(brandId) {
      return brandId == 'bruno-thailand' || brandId == 'join-lux-club';
    }

    function staffBrand() {
      return get(staffProfilePath()).data.brandId;
    }

    function validStaff() {
      return signedIn() && exists(staffProfilePath()) && canonicalBrand(staffBrand());
    }

    function hasRepairReportRole() {
      return validStaff() &&
        get(staffProfilePath()).data.keys().hasAll(['role']) &&
        get(staffProfilePath()).data.role in ['technician', 'approver', 'admin'];
    }

    function staffOwnsBrand(brandId) {
      return validStaff() && canonicalBrand(brandId) && staffBrand() == brandId;
    }

    function staffOwnsAttachment(attachment) {
      return staffOwnsBrand(
        get(/databases/$(database)/documents/serviceJobs/$(attachment.jobId)).data.brandId
      );
    }

    function staffOwnsCustomer(customer) {
      return validStaff() && staffBrand() in customer.brandIds;
    }

    match /staffProfiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /brands/{brandId} {
      allow read, write: if false;
    }

    match /serviceJobs/{serviceJobId} {
      allow get, list: if staffOwnsBrand(resource.data.brandId);
      allow create: if false;
      // The diff/affectedKeys check below is the sole guard on these
      // privileged fields — it denies any update that adds, removes, or
      // changes 'brandId'/'id'/'createdAt'/both hash fields, and does so
      // safely even when a legacy document never had one of them. A
      // previous version paired it with direct equality checks
      // (request.resource.data.createdAt == resource.data.createdAt, etc.);
      // those throw "Property ... is undefined on object" the moment either
      // side lacks the field, denying every ordinary update to a legacy
      // Service Job (F5d-33/F5d-34 B-2 — confirmed against the emulator).
      allow update: if staffOwnsBrand(resource.data.brandId) &&
        request.resource.data.brandId == resource.data.brandId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'brandId', 'id', 'createdAt', 'publicTrackingCodeHash', 'publicTrackingTokenHash'
        ]) &&
        validClosedAtTransition() &&
        validServiceEventMetadata();
      allow delete: if false;

      function validClosedAtTransition() {
        return request.resource.data.closedAt == resource.data.closedAt ||
          (resource.data.closedAt == null &&
            request.resource.data.closedAt is timestamp &&
            (request.resource.data.status == 'Completed' ||
              request.resource.data.status == 'Cancelled' ||
              request.resource.data.status == 'Rejected'));
      }

      // F5d-69 / DECISIONS.md #041 — Service Jobs are updated DIRECTLY from
      // the browser (ServiceJobDetails -> useUpdateServiceJob ->
      // firestoreServiceJobRepository.update()'s runTransaction), so these
      // rules are the only thing standing between an authenticated staff
      // session and arbitrary values in these fields. The Worker validates
      // the same contract on creation, where it bypasses Rules entirely with
      // privileged credentials; neither boundary can substitute for the other.
      //
      // Every accessor below is absence-tolerant: reading a field that a
      // legacy document (or a partial write) never had would throw
      // "Property ... is undefined on object" and deny the whole update, the
      // exact F5d-33/F5d-34 B-2 defect this rule block already carries a
      // comment about. `null` is a first-class accepted value here — it is
      // how the UI clears a field — so absent and null deliberately collapse
      // to the same result.
      function fieldOrNull(key) {
        return key in request.resource.data ? request.resource.data[key] : null;
      }
      function validOptionalString(key, maxLength) {
        return fieldOrNull(key) == null ||
          (fieldOrNull(key) is string && fieldOrNull(key).size() <= maxLength);
      }
      function validOptionalEnum(key, allowed) {
        return fieldOrNull(key) == null || fieldOrNull(key) in allowed;
      }
      // Syntactic YYYY-MM-DD with real month/day ranges. Rules deliberately
      // stop here: there is no date arithmetic available to reject an
      // impossible calendar date such as 2026-02-30, which the Worker DOES
      // reject on creation. That asymmetry is documented rather than hidden —
      // Rules enforce shape and range, the Worker enforces true calendar
      // validity.
      function validOptionalCalendarDate(key) {
        return fieldOrNull(key) == null ||
          (fieldOrNull(key) is string &&
            fieldOrNull(key).matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'));
      }
      // matches() is a whole-string RE2 match, so the https:// prefix cannot
      // be spoofed by a suffix, and RE2's '.' never matches a newline — a
      // value carrying a line break therefore fails closed here. Rules cannot
      // parse a URL, so scheme enforcement is textual; the Worker performs
      // real URL parsing and protocol inspection on the creation path.
      function validOptionalHttpsUrl(key, maxLength) {
        return fieldOrNull(key) == null ||
          (fieldOrNull(key) is string &&
            fieldOrNull(key).size() <= maxLength &&
            fieldOrNull(key).matches('https://.*'));
      }
      function validServiceEventMetadata() {
        return validOptionalEnum('contactChannel',
            ['shopee', 'lazada', 'line', 'store', 'website', 'phone', 'other']) &&
          validOptionalString('contactChannelIdentity', 120) &&
          validOptionalString('orderNumber', 64) &&
          validOptionalEnum('orderVerification', ['unverified', 'verified', 'not_found']) &&
          validOptionalCalendarDate('purchaseDate') &&
          validOptionalCalendarDate('orderDeliveredDate') &&
          validOptionalHttpsUrl('externalEvidenceUrl', 2048) &&
          validOptionalString('externalEvidenceNote', 1000) &&
          validServiceEventMetadataInvariants();
      }
      // The same cross-field invariants the Worker resolves at creation, so a
      // later browser edit cannot reintroduce a state the creation path would
      // never have produced: verification without an order number, an order
      // number without a verification state, an identity without a channel,
      // or a 'phone' channel carrying its own identity (the customer's
      // canonical phone is that identity).
      //
      // F5d-69 Phase 2A-FIX: the order/verification pair was originally only
      // checked in one direction (verification implies an order number),
      // which let a resulting document carry a non-null orderNumber with a
      // null/missing orderVerification — a state the Worker's own
      // resolveIntakeMetadata() never produces (it always resolves
      // verification to at least 'unverified' whenever an order number is
      // present). The second clause below closes that direction. Both
      // clauses together only constrain the RESULTING document
      // (request.resource.data) — they never compare against resource.data
      // (the pre-write state) — which is deliberate, not an oversight: this
      // app's own update path (firestoreServiceJobRepository.ts's
      // toFirestoreUpdateFields()) always re-sends all eight F5d-69 fields
      // explicitly on every single edit, echoing a legacy document's absent
      // fields back as explicit nulls, so a legacy document's first-ever
      // edit through this app already produces a resulting orderNumber/
      // orderVerification pair of (null, null) — satisfying this invariant
      // with no migration needed. A raw partial Firestore write that
      // legitimately leaves both fields untouched (as a legacy document that
      // has never had either field does) resolves the same way through
      // fieldOrNull()'s absence tolerance: both sides read as null, and the
      // biconditional holds. The only state this newly denies is a
      // resulting document with exactly one of the two set — which no
      // legitimate legacy or Worker-created document can already be in.
      function validServiceEventMetadataInvariants() {
        return (fieldOrNull('orderNumber') != null || fieldOrNull('orderVerification') == null) &&
          (fieldOrNull('orderVerification') != null || fieldOrNull('orderNumber') == null) &&
          (fieldOrNull('contactChannel') != null || fieldOrNull('contactChannelIdentity') == null) &&
          (fieldOrNull('contactChannel') != 'phone' || fieldOrNull('contactChannelIdentity') == null);
      }
    }

    match /numberSequences/{sequenceId} {
      allow read, write: if false;
    }

    match /serviceJobIntakeKeys/{key} {
      allow read, write: if false;
    }

    match /serviceJobAttachments/{attachmentId} {
      allow get, list: if staffOwnsAttachment(resource.data);
      allow create: if attachmentId.matches('ak2_[0-9a-f]{64}') &&
        request.resource.data.keys().hasAll([
          'jobId', 'category', 'name', 'path', 'contentType', 'size',
          'uploadedAt', 'uploadedBy', 'deleteAfter', 'retentionStatus',
          'retentionExtensions', 'deletedAt', 'metadataKeyVersion',
          'approvalRetainUntil'
        ]) &&
        request.resource.data.keys().hasOnly([
          'jobId', 'category', 'name', 'path', 'contentType', 'size',
          'uploadedAt', 'uploadedBy', 'deleteAfter', 'retentionStatus',
          'retentionExtensions', 'deletedAt', 'metadataKeyVersion',
          'approvalRetainUntil'
        ]) &&
        request.resource.data.metadataKeyVersion == 2 &&
        request.resource.data.path is string &&
        request.resource.data.path.size() >= 1 && request.resource.data.path.size() <= 1024 &&
        request.resource.data.path.matches('service-jobs/[A-Za-z0-9_-]+/(before|after|documents|report)/[A-Za-z0-9._-]+') &&
        request.resource.data.path.matches('.*%.*') == false &&
        request.resource.data.category in ['before', 'after', 'documents', 'report'] &&
        request.resource.data.size is int && request.resource.data.size >= 0 &&
        request.resource.data.deletedAt == null &&
        request.resource.data.approvalRetainUntil == null &&
        staffOwnsAttachment(request.resource.data);
      allow update: if staffOwnsAttachment(resource.data) &&
        immutableAttachmentFieldsPreserved() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deleteAfter', 'retentionStatus', 'retentionExtensions'
        ]);
      allow delete: if false;

      function immutableAttachmentFieldsPreserved() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'jobId', 'category', 'name', 'path', 'contentType', 'size',
          'uploadedAt', 'uploadedBy', 'metadataKeyVersion',
          'approvalRetainUntil', 'deletedAt'
        ]);
      }
    }

    match /products/{productId} {
      allow get, list: if validStaff();
      allow create, update, delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if staffOwnsCustomer(resource.data);
      allow create, update, delete: if false;
    }

    match /serviceReports/{reportId} {
      allow get: if staffOwnsServiceReport(resource.data);
      allow list: if false;
      allow create: if false;
      allow update: if validV2DraftUpdate();
      allow delete: if false;

      function validV2DraftUpdate() {
        return hasRepairReportRole() &&
          staffOwnsServiceReport(resource.data) &&
          resource.data.schemaVersion == 2 &&
          resource.data.status == 'draft' &&
          resource.data.approvalState == 'not-submitted' &&
          request.resource.data.schemaVersion == 2 &&
          request.resource.data.status == 'draft' &&
          request.resource.data.approvalState == 'not-submitted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'technician', 'customerReportedProblem', 'inspectionFindings',
          'serviceActions', 'parts', 'technicianRemark', 'resultStatus',
          'resultDetail', 'evidenceAttachmentIds', 'claimNo',
          'factoryReference', 'warrantyOutcome', 'contentRevision', 'updatedAt'
        ]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'technician', 'customerReportedProblem', 'inspectionFindings',
            'serviceActions', 'parts', 'technicianRemark', 'resultStatus',
            'resultDetail', 'evidenceAttachmentIds', 'claimNo',
            'factoryReference', 'warrantyOutcome'
          ]) &&
          request.resource.data.contentRevision == resource.data.contentRevision + 1 &&
          request.resource.data.updatedAt == request.time &&
          validV2EditableProjection();
      }

      function validV2EditableProjection() {
        return request.resource.data.technician is string &&
          request.resource.data.technician.size() <= 200 &&
          request.resource.data.customerReportedProblem is string &&
          request.resource.data.customerReportedProblem.size() <= 4000 &&
          request.resource.data.inspectionFindings is string &&
          request.resource.data.inspectionFindings.size() <= 4000 &&
          request.resource.data.serviceActions is list &&
          request.resource.data.serviceActions.size() <= 20 &&
          request.resource.data.parts is list && request.resource.data.parts.size() <= 50 &&
          request.resource.data.technicianRemark is string &&
          request.resource.data.technicianRemark.size() <= 4000 &&
          (request.resource.data.resultStatus == null ||
            request.resource.data.resultStatus in [
              'repaired', 'awaiting-part', 'sent-for-claim', 'replaced',
              'returned', 'unable-to-repair'
            ]) &&
          request.resource.data.resultDetail is string &&
          request.resource.data.resultDetail.size() <= 4000 &&
          request.resource.data.evidenceAttachmentIds is list &&
          request.resource.data.evidenceAttachmentIds.size() <= 50 &&
          request.resource.data.evidenceAttachmentIds.toSet().size() ==
            request.resource.data.evidenceAttachmentIds.size() &&
          (request.resource.data.claimNo == null ||
            (request.resource.data.claimNo is string && request.resource.data.claimNo.size() <= 200)) &&
          (request.resource.data.factoryReference == null ||
            (request.resource.data.factoryReference is string && request.resource.data.factoryReference.size() <= 200)) &&
          request.resource.data.warrantyOutcome in ['covered', 'chargeable', 'undetermined'];
      }
    }

    function staffOwnsServiceReport(report) {
      return staffOwnsBrand(
        get(/databases/$(database)/documents/serviceJobs/$(report.serviceJobId)).data.brandId
      );
    }

    // Worker-only allocator collections (F5d-66). No carve-out is needed
    // for the paired lock/report state — since finalize never runs
    // client-side, serviceReportActiveDrafts needs no getAfter()/
    // existsAfter() rule at all, unlike DECISIONS.md #040's rejected
    // Option B.
    match /serviceReportActiveDrafts/{serviceJobId} {
      allow read, write: if false;
    }

    match /serviceReportApprovals/{eventId} {
      allow read, write: if false;
    }

    match /brandApprovalPolicies/{brandId} {
      allow read, write: if false;
    }

    match /serviceReportIdempotency/{keyHash} {
      allow read, write: if false;
    }

    match /serviceReportSuccessorClaims/{predecessorReportId} {
      allow read, write: if false;
    }

    match /attachmentRetentionHolds/{holdId} {
      allow read, write: if false;
    }

    match /attachmentDeletionClaims/{claimId} {
      allow read, write: if false;
    }

    match /attachmentDeletionOperations/{operationId} {
      allow read, write: if false;
    }

    match /serviceReportDraftKeys/{key} {
      allow read, write: if false;
    }
  }
}
